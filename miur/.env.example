# =============================================================================
#  Miur — environment variables
# =============================================================================
#
#  How to use:
#    1. Copy this file to .env.local and fill values for local dev.
#    2. In Vercel, set the same variables in Settings → Environment Variables
#       (Production / Preview / Development) — values are injected at build time.
#    3. Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle,
#       so DO NOT put secrets there. Server-only secrets go without that prefix.
#
#  Production deploys ENFORCE the variables marked [REQUIRED] below — the build
#  on Vercel will fail with a clear error if any are missing or invalid.
#  See lib/env/server-env.ts for the validation rules.
#
#  Escape hatch (NOT recommended for prod):
#    NEXT_PUBLIC_SKIP_ENV_VALIDATION=1
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# [REQUIRED, prod] Public canonical URL (used in sitemap, robots, canonical tags, OG).
# Must be a fully-qualified URL with protocol. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.miur.pl


# -----------------------------------------------------------------------------
# Seller identity — UŚUDE art. 5 + RODO art. 13
# Must appear in the footer of every page on the live store.
# -----------------------------------------------------------------------------

# [REQUIRED, prod] Registered legal name (e.g. "Salgo Sp. z o.o." or "Jan Kowalski JDG")
NEXT_PUBLIC_SELLER_LEGAL_NAME=

# [REQUIRED, prod] Street address line 1 (e.g. "ul. Marszałkowska 1")
NEXT_PUBLIC_SELLER_ADDRESS_LINE1=

# [optional] Address line 2 (e.g. "00-001 Warszawa")
NEXT_PUBLIC_SELLER_ADDRESS_LINE2=

# [REQUIRED, prod] NIP — exactly 10 digits, no spaces or dashes
NEXT_PUBLIC_SELLER_NIP=

# [REQUIRED, prod] REGON — 9 or 14 digits
NEXT_PUBLIC_SELLER_REGON=

# [optional] KRS — only for sp. z o.o. / S.A. (10 digits). Leave empty for JDG.
NEXT_PUBLIC_SELLER_KRS=

# [REQUIRED, prod] Public support email shown in footer & legal pages
NEXT_PUBLIC_SELLER_EMAIL=pomoc@miur.pl

# [optional] Public support phone (international format preferred, e.g. "+48 22 000 00 00")
NEXT_PUBLIC_SELLER_PHONE=


# -----------------------------------------------------------------------------
# Tag Manager — loaded ONLY after the user opts in via the cookie banner
# (see components/layout/ConsentScripts.tsx). Leave blank to fully disable GTM.
# -----------------------------------------------------------------------------

# [optional] Google Tag Manager container ID. Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=


# -----------------------------------------------------------------------------
# Auth.js v5 — session signing + Google OAuth provider
# -----------------------------------------------------------------------------

# [REQUIRED] Secret used to sign/encrypt JWTs. Generate with:
#   openssl rand -base64 32
# Rotating this invalidates every existing session. Never commit the real value.
AUTH_SECRET=

# [REQUIRED for Google OAuth] OAuth 2.0 client from Google Cloud Console.
# Authorized redirect URI must be: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
