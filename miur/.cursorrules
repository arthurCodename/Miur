## 6. COMPONENT PATTERNS
 
### Section anatomy (reference all layout components)
```tsx
// Standard section structure
<section className="w-full bg-white border-t border-zinc-100 py-24 px-6 lg:px-12">
  {/* Section label */}
  <span className="text-[10px] font-bold uppercase tracking-[0.3em] text-zinc-400">
    Label
  </span>
  
  {/* Heading */}
  <h2 className="text-4xl font-bold tracking-tighter text-zinc-900 uppercase mt-4">
    Heading
  </h2>
  
  {/* Content */}
  <div className="mt-12">...</div>
</section>
```
 
### Buttons
```tsx
// Primary — filled
<button className="px-8 py-3 bg-zinc-900 text-white text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-zinc-700 transition-colors">
  Label
</button>
 
// Secondary — outline
<button className="px-8 py-3 border border-zinc-900 text-zinc-900 text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-zinc-900 hover:text-white transition-all">
  Label
</button>
 
// Ghost — text only with underline
<button className="text-[10px] font-bold uppercase tracking-widest hover:opacity-50 transition-opacity">
  Label
</button>
 
// Icon button
<button className="w-9 h-9 flex items-center justify-center rounded-full border border-zinc-200 hover:border-zinc-900 hover:bg-zinc-900 hover:text-white transition-all">
  <Icon className="w-4 h-4" />
</button>
```
 
### Cards
```tsx
// Product card base pattern
<div className="group relative overflow-hidden">
  {/* Image with hover zoom */}
  <div className="overflow-hidden aspect-3/4">
    <Image 
      className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      alt="Product description"  // Always descriptive
    />
  </div>
  
  {/* Info */}
  <div className="mt-3 flex flex-col gap-1">
    <p className="text-[10px] uppercase tracking-widest text-zinc-400">Brand</p>
    <h3 className="text-sm font-medium text-zinc-900">Product Name</h3>
    <p className="text-sm text-zinc-900">{price} zł</p>
  </div>
</div>
```
 
### Framer Motion patterns
```tsx
"use client";
import { motion, useScroll, useTransform, AnimatePresence, useReducedMotion } from "framer-motion";
 
// Always check prefers-reduced-motion
const shouldReduceMotion = useReducedMotion();
 
// Fade in on scroll
const { scrollYProgress } = useScroll({ target: ref, offset: ["start end", "end start"] });
const opacity = useTransform(scrollYProgress, [0, 0.3], [0, 1]);
 
// Stagger children
const containerVariants = {
  hidden: {},
  visible: { transition: { staggerChildren: 0.05 } }
};
const itemVariants = {
  hidden: { opacity: 0, y: 20 },
  visible: { opacity: 1, y: 0, transition: { duration: 0.4 } }
};
 
// AnimatePresence for conditional rendering (CookieBanner, modals)
<AnimatePresence>
  {isOpen && (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, y: 20 }}
    >
      ...
    </motion.div>
  )}
</AnimatePresence>
```
 
### shadcn/ui usage
```tsx
// Always check if shadcn component exists BEFORE creating custom UI
// Available: Button, Dialog, Input, Sheet, Sonner (toast)
 
// Import from @/components/ui/
import { Button } from "@/components/ui/button";
import { Sheet, SheetContent, SheetTrigger } from "@/components/ui/sheet";
import { Input } from "@/components/ui/input";
 
// Add new components: npx shadcn@latest add [component-name]
// Ask Bogdan before adding — some have side effects
```
 
