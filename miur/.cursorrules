## 7. NEXT.JS 16 APP ROUTER PATTERNS
 
### Data fetching
```tsx
// ✅ Server components fetch directly — no useEffect, no SWR for server data
export default async function Page() {
  const products = await getProducts();  // Direct async call
  return <ProductGrid products={products} />;
}
 
// ✅ Parallel fetching with Promise.all (see page.tsx)
const [bestsellers, blog] = await Promise.all([
  getBestsellers(),
  getBlogPosts()
]);
 
// ✅ Client-side state/fetching only for interactive features
"use client";
const [cartCount, setCartCount] = useState(0);
```
 
### Metadata
```tsx
// Static
export const metadata: Metadata = {
  title: "Miur | Wellness Store",
  description: "...",
};
 
// Dynamic (product pages)
export async function generateMetadata({ params }: { params: { slug: string } }): Promise<Metadata> {
  const product = await getProduct(params.slug);
  return { title: `${product.name} | Miur` };
}
```
 
### Images
```tsx
// Always next/image, never <img>
import Image from "next/image";
 
<Image
  src="/product.jpg"
  alt="Descriptive alt text"  // Never empty unless decorative
  width={400}
  height={600}
  className="object-cover"
  priority  // Only for above-the-fold images
/>
 
// Decorative images
<Image src="/decoration.svg" alt="" role="presentation" aria-hidden />
```
 
### Fonts
```tsx
// Already configured in layout.tsx — do not re-add
// Use: className="font-(family-name:--font-logo)" for logo font
// Use: className={inter.className} already applied to body
```
 
