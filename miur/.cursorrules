## 4. CODE CONVENTIONS — NON-NEGOTIABLE
 
### TypeScript
```ts
// ✅ Always strict types
interface ProductCardProps {
  product: Product;
  onAddToCart: (id: string) => void;
}
 
// ❌ Never any
const data: any = ...  // FORBIDDEN
```
 
### Components
```tsx
// ✅ Named exports always
export function ProductCard({ product }: ProductCardProps) { ... }
 
// ❌ Never default export for components
export default function ProductCard() { ... }  // FORBIDDEN (except page.tsx files — Next.js requires it)
 
// ✅ Server component by default (no directive needed)
// ✅ "use client" only when using: hooks, event handlers, browser APIs, framer-motion
 
// ✅ Props interface above component
interface Props { ... }
export function Component({ ... }: Props) { ... }
```
 
### Imports
```tsx
// ✅ Always @/ alias
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";
 
// ❌ Never relative paths
import { Button } from "../../../components/ui/button";  // FORBIDDEN
```
 
### Tailwind CSS 4
```css
/* ✅ Tailwind 4 syntax */
@import "tailwindcss";
 
/* ❌ Old syntax — DO NOT USE */
@tailwind base;       /* FORBIDDEN */
@tailwind components; /* FORBIDDEN */
@tailwind utilities;  /* FORBIDDEN */
```
 
```tsx
// ✅ Tailwind only for styling
className="flex items-center gap-4 text-zinc-900"
 
// ❌ No inline styles (exception: framer-motion `style` prop with motion values)
style={{ color: '#000' }}  // FORBIDDEN
 
// ❌ No CSS modules
import styles from './Card.module.css'  // FORBIDDEN
```
 
### Conditional classes
```tsx
// ✅ Use cn() for conditional classes
import { cn } from "@/lib/utils";
 
<div className={cn(
  "base-classes",
  isActive && "active-classes",
  variant === "outline" && "outline-classes"
)} />
```
 
